<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script> 
</head>
<body>
        <div class="w-full h-full bg-zinc-900 text-white" style="height: 100vh;">
            <div class="nav mb-10">
                    <a class="text-blue-500" href="/read" style="position: relative; top:15px">Read Users</a>
            </div>
            <h1 class="text-3xl tracking-tighter mb-3">Create User</h1>
            <form action="/create" method="POST">
                <input class="px-5 py-3 border-2 border-zinc-800 rounded-lg outline-none bg-transparent" type="text" placeholder="name" name="name">
                <input class="px-5 py-3 border-2 border-zinc-800 rounded-lg outline-none bg-transparent" type="text" placeholder="email" name="email">
                <input class="px-5 py-3 border-2 border-zinc-800 rounded-lg outline-none bg-transparent" type="text" placeholder="image url" name="image">
                <input class="px-5 py-3 bg-blue-500" type="submit" value="create user">
            </form>
        </div>
</body>
</html>