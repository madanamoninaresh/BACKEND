<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script> 
</head>
<body>
        <div class="w-full h-full bg-zinc-900 text-white" style="height: 100vh;">
            <div class="nav mb-10">
                    <a class="text-blue-500" href="/read" style="position: relative; top:15px">Read Users</a>
            </div>
            <h1 class="text-3xl tracking-tighter mb-3">Update User</h1>
            <form action="/update/<%= user.id%>" method="POST">
                <input class="px-5 py-3 border-2 border-zinc-800 rounded-lg outline-none bg-transparent" type="text"  placeholder="name" value = "<%= user.name%>" name="name">
                <input class="px-5 py-3 border-2 border-zinc-800 rounded-lg outline-none bg-transparent" type="text"  placeholder="email" value = "<%= user.email%>" name="email">
                <input class="px-5 py-3 border-2 border-zinc-800 rounded-lg outline-none bg-transparent" type="text"  placeholder="image url" value = "<%= user.image%>" name="image">
                <input class="px-5 py-3 bg-yellow-500" type="submit" value="update user">
            </form>
        </div>
</body>
</html>