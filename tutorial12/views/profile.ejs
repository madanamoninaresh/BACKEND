<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="w-full flex justify-end">
            <a href="/logout" class="bg-red-500 px-6 py-1 rounded-md text-sm mb-5 inline-block">Logout</a>
        </div>
        <h3 class="text-3xl mb-5">Your Profile</h3>
        <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-md overflow-hidden">
                <img class="w-full h-full object-cover" src="/images/uploads/<%= user.profilepic%>">
            </div>
            <h3 class="text-3xl mb-2"><span class="font-light">Hello</span> <%= user.name %></h3>
        </div>
        <h5 class="text-3xl mb-5 mt-3">You can create a new post.</h5>
        <form method="POST" action="/post">
            <textarea placeholder="what`on your mind?" class="block p-3 outline-none w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md" name="content"></textarea>
            <input class="px-3 py-2 w-40 bg-blue-500 text-sm block rounded-md mt-3" type="submit" value="Create New Post">
        </form>
        <div class="posts mt-20">
            <h3 class="text-zinc-400">Your posts</h3>
            <div class="postcontainer mt-5">
                        <% user.posts.reverse().forEach(function(post){ %>
                                <div class="post w-1/3 p-4 rounded-md mb-2 border-[1px] bg-zinc-800 border-zinc-700">
                                    <h4 class="text-blue-500 mb-3"><%= user.username%></h4>
                                    <p class="text-sm tracking-tight"><%= post.content%></p>
                                    <small class="mt-2 inline-block"><%=  post.likes.length %> Likes</small>

                                    <div class="btn flex gap-5 mt-5">
                                        <a class="text-blue-500" href="/like/<%= post._id%>">
                                            <%= post.likes.indexOf(user._id) === -1 ? "Like": "Unlike" %>
                                        </a>
                                        <a class="text-zinc-600" href="/edit/<%= post._id%>">Edit</a>
                                    </div>
                                </div>
                        <% })%>
                    
                </div>
            </div>
        </div>
    </div>
</body>
</html>