<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="w-full flex justify-end">
            <a href="/logout" class="bg-red-500 px-6 py-1 rounded-md text-sm mb-5 inline-block">Logout</a>
        </div>
        <!-- <h3 class="text-3xl mb-5">Your Profile</h3> -->
        <h3>Edit your post</h3>
        <form method="POST" action="/update/<%= post._id%>">
            <textarea placeholder="what`on your mind?" class="block p-3 outline-none w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md" name="content"><%= post.content%></textarea>
            <input class="px-3 py-2 w-40 bg-yellow-500 text-black text-sm block rounded-md mt-3" type="submit" value="update Post">
        </form>
    </div>
</body>
</html>