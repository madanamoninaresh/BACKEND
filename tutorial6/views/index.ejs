<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        .main{
            background-color: #18181b;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div calss="main w-100% h-100% bg-zinc-800" style="background-color: #18181b;">
        <div class="form p-10 text-white">
            <form action="/create" method="POST">
                <input class="block px-5 py-3 mt-2 w-full rounded-md outline-none bg-zinc-800" type="text" placeholder="title" name="title">
                <textarea class="block px-5 py-3 mt-2 w-full rounded-md outline-none bg-zinc-800 resize-none" placeholder="write description" name="details"></textarea>
                <input class="bg-blue-600 px-5 py-3 rounded-md mt-2"type="submit" placeholder="create task">
            </form>
        </div>
        <div class="tasks  flex gap-3 flex-wrap p-10">
            <% if(files.length > 0) { %>
                <% files.forEach((val)=>{ %>
                    <div class="task min-w-72 px-3 py-4 rounded-md bg-zinc-800">
                            <h1 class="text-white text-3xl tracking-tighter"><%= val%></h1>
                            <div class="flex justify-between align-center mt-2">
                                <a class="text-blue-600 inline-block " href="/files/<%=val%>">read more</a>
                                <a class="tex-zinc-800" href="/edit/<%=val%>">edit file name</a>
                            </div>
                    </div>
               <% }) %>
               <% } else { %>
                        <h3 class="text-zinc-600">no tasks yet</h3>
               <% } %>
        </div>
    </div>
</body>
</html>